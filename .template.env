DATABASE_URL=postgresql://postgres:postgres@localhost:24313/postgres?schema=public
SENTRY_SUPPRESS_TURBOPACK_WARNING=1
# Origin the browser apps are served from. Also the source of the session cookie's Domain flag
# and the API's CORS allowlist, so in production this must be the real site URL.
NEXT_PUBLIC_HOST_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Port for the standalone Hono API in `pnpm run dev` (website 3000, dashboard 3002, admin 3003)
API_PORT=3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
