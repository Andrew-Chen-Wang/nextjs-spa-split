DATABASE_URL=postgresql://postgres:postgres@localhost:24313/postgres?schema=public
SENTRY_SUPPRESS_TURBOPACK_WARNING=1
NEXT_PUBLIC_HOST_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Port for the standalone Hono API in `pnpm run dev` (website 3000, dashboard 3002, admin 3003)
API_PORT=3001

# Parent domain for the session cookie, e.g. .example.com (note the leading dot). Set this ONLY
# in production: it is what lets the cookie the website sets reach the API on api.example.com.
# Locally both run on `localhost` and cookies ignore ports, so it must stay unset.
# COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
